{
  "name": "openclaw-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:apps": "node --test tests/app-contract.test.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "pack:apps": "npm run test:apps && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "jsdom": "30.1.1",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "zod": "4.3.6"
  }
}
